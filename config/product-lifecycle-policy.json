{
  "schemaVersion": 1,
  "policyId": "PPT-LIFECYCLE-STRICT-V1",
  "immutable": true,
  "owner": "Panthera pardus tulliana",
  "rules": {
    "newProductDevelopmentChannel": "bronze",
    "allSilverPlannedCapabilitiesMustBeImplementedInBronze": true,
    "allGoldPlannedCapabilitiesMustBeImplementedInBronze": true,
    "silverAllowedWork": [
      "infrastructure_improvement",
      "test_execution",
      "defect_fix"
    ],
    "goldAllowedWork": [
      "release_packaging",
      "production_operations",
      "critical_defect_fix"
    ],
    "apiDeferral": {
      "allowedOnlyForHeavyExternalApiIntegration": true,
      "targetChannelRemainsBronze": true,
      "requiredArchitectureReadiness": [
        "portContract",
        "adapterBoundary",
        "configurationBoundary",
        "localFallback",
        "testDouble",
        "errorContract",
        "securityPrivacyBoundary"
      ]
    },
    "decisionPropagation": {
      "allActiveInformationAndDocuments": true,
      "masterDecisionRegister": true,
      "authorityMatrix": true,
      "scopeAndRoadmap": true,
      "releaseAndTestGovernance": true,
      "architectureDecisionRecord": true,
      "machineReadablePolicy": true,
      "sourceVerificationContract": true
    }
  },
  "bindingDecisions": [
    "DEC-068",
    "DEC-069",
    "DEC-070",
    "DEC-071",
    "DEC-072",
    "DEC-073",
    "DEC-074",
    "DEC-075",
    "DEC-076",
    "DEC-077",
    "DEC-078",
    "DEC-079",
    "DEC-080",
    "DEC-081",
    "DEC-082",
    "DEC-083",
    "DEC-084",
    "DEC-085",
    "DEC-086",
    "DEC-087"
  ],
  "securityInvariants": {
    "externalEvidenceRootTrust": "out_of_band_dual_evidence",
    "independentEvidenceChannels": 2,
    "exactEd25519FingerprintMatch": true,
    "witnessRequired": true,
    "rawIdentityDocumentsStored": false,
    "legacyRootWarningRequired": true,
    "automaticCleanBackupRewrite": "verified_backup_before_quarantine",
    "manualFailureBackoffMinutes": 60,
    "automaticFailureBackoffMinutes": 360,
    "highLoadDeferMinutes": 30,
    "cleanBackupRewriteFinalization": "atomic_policy_and_run_ledger",
    "cleanBackupRewriteRunLedger": true,
    "staleRunFinalizationDenied": true,
    "sqliteBindingRegressionRequired": true,
    "managedBackupPropagationChronology": "monotonic_elapsed_time_anchored_to_wall_start",
    "precomputedPropagationCompletionTimeForbidden": true,
    "backwardMonotonicClockDenied": true,
    "pendingCompletionUsesFinalPropagationTime": true,
    "cleanRewriteLinkedChronology": "propagation_completion_is_authoritative",
    "cleanRewriteSuccessRequiresPropagationRun": true,
    "cleanRewriteCompletionBeforePropagationDenied": true,
    "cleanRewriteBackwardWallClockFloored": true,
    "sqliteLinkedChronologyTriggersRequired": true,
    "cleanRewriteInterruptedRecoveryChronology": "persisted_start_is_safe_floor",
    "interruptedRecoveryBackoffFromSafeCompletion": true,
    "runningClaimClearsPriorNextAttempt": true,
    "sqliteRecoveryRetryTriggersRequired": true,
    "cleanRewriteClaimChronology": "persistent_policy_chronology_is_safe_floor",
    "claimStatusReevaluatedAtSafeTime": true,
    "claimBackoffCannotBeBypassed": true,
    "claimRetentionCutoffBoundToSafeStart": true,
    "sqliteClaimChronologyTriggersRequired": true,
    "singleRunningCleanRewriteLedger": true,
    "cleanRewriteOperationalIsolation": "active_policy_settings_locked",
    "activeCleanRewritePolicyMutationDenied": true,
    "interruptedRecoveryUsesLedgerUpdateFloor": true,
    "cleanRewriteTerminalStateMappingRequired": true,
    "sqliteOperationalIsolationTriggersRequired": true,
    "cleanRewriteTerminalChronology": "monotonic_elapsed_time_anchored_to_safe_claim_start",
    "nonPropagationTerminalWallClockForbidden": true,
    "terminalRetryAnchoredToMonotonicCompletion": true,
    "invalidTerminalMonotonicClockDenied": true,
    "linkedPropagationCompletionRemainsAuthoritative": true,
    "cleanRewriteTriggerAwareBackoff": "terminal_and_interrupted_retry_bound_to_run_trigger",
    "manualAttentionBackoffMinutes": 60,
    "automaticAttentionBackoffMinutes": 360,
    "interruptedRetryUsesPersistedTrigger": true,
    "sqliteTriggerAwareBackoffRequired": true,
    "wrongTriggerBackoffDenied": true,
    "cleanRewriteManualAvailability": "manual_run_independent_of_automatic_enabled_flag",
    "disabledPolicyManualRunAllowed": true,
    "disabledPolicyAutomaticRunDenied": true,
    "manualRunStillRespectsBackoff": true,
    "sqliteManualAvailabilityTriggersRequired": true,
    "cleanRewriteRunningLedgerIdentity": "policy_owner_id_trigger_and_claim_chronology_match",
    "orphanRunningLedgerDenied": true,
    "runningLedgerIdentityMutationDenied": true,
    "activeRunningLedgerDeletionDenied": true,
    "sqliteRunningLedgerIdentityTriggersRequired": true,
    "cleanRewriteClaimReservation": "single_use_persistent_claim_reservation",
    "reservationlessPolicyClaimDenied": true,
    "claimReservationConsumptionRequiresOwnership": true,
    "cleanRewriteActiveOwnershipSnapshot": "immutable_until_terminal_transition",
    "activePolicyOwnershipClockMutationDenied": true,
    "activeLedgerWorkloadMutationDenied": true,
    "terminalTransitionRequiresConsumedReservation": true,
    "sqliteActiveOwnershipSnapshotTriggersRequired": true,
    "cleanRewriteActivePolicyParameters": "immutable_while_running_including_terminal_statement",
    "activePolicyEnabledMutationDenied": true,
    "activePolicyRetentionMutationDenied": true,
    "activePolicyBackoffMutationDenied": true,
    "terminalStatementParameterSmugglingDenied": true,
    "sqliteActivePolicyParameterTriggerRequired": true,
    "cleanRewriteAtomicTerminalTransition": "terminal_ledger_finalizes_policy_in_same_sql_statement",
    "policyOnlyTerminalTransitionDenied": true,
    "terminalLedgerOwnsPolicyFinalization": true,
    "terminalWorkloadMutationDenied": true,
    "interruptedRecoveryUsesAtomicTerminalLedger": true,
    "sqliteAtomicTerminalTransitionTriggersRequired": true
  },
  "externalIntegrationPriority": {
    "P0": [
      "backup",
      "ai",
      "system-critical adapters"
    ],
    "P1": [
      "core-function-required integrations"
    ],
    "P2": [
      "banks",
      "insurance",
      "health institutions",
      "government/other institutions"
    ],
    "p2ReviewAfterStableProductionMonths": "5-6"
  }
}
