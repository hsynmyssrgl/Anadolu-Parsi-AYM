{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parsyuva.local/schemas/ticari-karar-v1.json",
  "title": "ParsYuva Aile Yasam Merkezi Karar Kaydi",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tarih",
    "baslik",
    "durum",
    "kaynak",
    "etkilenenAlanlar",
    "isListesiEtkisi",
    "senkronDurumu"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^DEC-[0-9]{3}$" },
    "tarih": { "type": "string", "format": "date" },
    "baslik": { "type": "string", "minLength": 3 },
    "durum": { "enum": ["ACTIVE", "SUPERSEDED"] },
    "kaynak": { "type": "string", "minLength": 3 },
    "etkilenenAlanlar": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "isListesiEtkisi": { "type": "string", "minLength": 10 },
    "senkronDurumu": { "enum": ["SYNCHRONIZED", "BLOCKED"] },
    "yerineGectigi": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DEC-[0-9]{3}$" },
      "uniqueItems": true
    }
  }
}
