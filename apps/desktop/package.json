{
  "name": "@ppt/desktop",
  "version": "18.8.2026-30",
  "private": true,
  "type": "module",
  "main": "dist/main/main.mjs",
  "dependencies": {
    "@ppt/application": "18.8.2026-30",
    "@ppt/config": "18.8.2026-30",
    "@ppt/contracts": "18.8.2026-30",
    "@ppt/core": "18.8.2026-30",
    "@ppt/core-service-client": "18.8.2026-30",
    "@ppt/core-service-contracts": "18.8.2026-30",
    "@ppt/database": "18.8.2026-30",
    "@ppt/domain": "18.8.2026-30",
    "@ppt/events": "18.8.2026-30",
    "@ppt/infrastructure": "18.8.2026-30",
    "@ppt/logging": "18.8.2026-30",
    "@ppt/platform-policy": "18.8.2026-30",
    "@ppt/repositories": "18.8.2026-30",
    "@ppt/repository-contracts": "18.8.2026-30",
    "@ppt/security": "18.8.2026-30",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.2.0",
    "vite": "8.1.5"
  },
  "scripts": {
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "package:win": "node scripts/build-signed-windows-release.mjs",
    "package:win:dir": "npm run verify:license-sync && npm run build && npm run verify:installer --workspace @ppt/desktop && node scripts/run-electron-builder.mjs --dir",
    "verify:installer": "node scripts/verify-installer.mjs",
    "verify:freeze": "node scripts/verify-release-freeze.mjs",
    "verify": "npm run verify:license-sync && npm run typecheck && npm test && npm run build && npm run verify:installer",
    "sync:license:rtf": "node scripts/generate-license-rtf.mjs",
    "verify:license-sync": "node scripts/verify-license-rtf-sync.mjs"
  },
  "build": {
    "appId": "tr.anadoluparsi.aileyasammerkezi",
    "productName": "Anadolu Parsı Aile Yaşam Merkezi",
    "asar": true,
    "afterPack": "scripts/apply-electron-fuses.mjs",
    "forceCodeSigning": true,
    "electronDownload": {
      "cache": "../../artifacts/validation/electron-cache"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Anadolu-Parsi-Aile-Yasam-Merkezi-Bronze-18.08.2026.30-${arch}-Kurulum.${ext}",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": true,
      "allowElevation": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Anadolu Parsı AYM",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "build/LICENSE_TR.rtf",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "copyright": "Copyright © 2026 Panthera pardus tulliana",
    "artifactName": "Anadolu-Parsi-Aile-Yasam-Merkezi-Bronze-18.08.2026.30-${arch}-Kurulum.${ext}"
  },
  "description": "Anadolu Parsı yerel öncelikli aile yaşam, güvenlik ve dijital hafıza merkezi.",
  "author": {
    "name": "Panthera pardus tulliana"
  }
}
