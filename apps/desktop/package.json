{
  "name": "@ppt/desktop",
  "version": "20.8.2026-40",
  "private": true,
  "type": "module",
  "main": "dist/main/main.mjs",
  "dependencies": {
    "@ppt/application": "20.8.2026-40",
    "@ppt/config": "20.8.2026-40",
    "@ppt/contracts": "20.8.2026-40",
    "@ppt/core": "20.8.2026-40",
    "@ppt/core-service-client": "20.8.2026-40",
    "@ppt/core-service-contracts": "20.8.2026-40",
    "@ppt/database": "20.8.2026-40",
    "@ppt/domain": "20.8.2026-40",
    "@ppt/events": "20.8.2026-40",
    "@ppt/infrastructure": "20.8.2026-40",
    "@ppt/logging": "20.8.2026-40",
    "@ppt/platform-policy": "20.8.2026-40",
    "@ppt/repositories": "20.8.2026-40",
    "@ppt/repository-contracts": "20.8.2026-40",
    "@ppt/security": "20.8.2026-40",
    "maplibre-gl": "6.4.1",
    "pmtiles": "4.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.2.0",
    "vite": "8.1.5"
  },
  "scripts": {
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "package:win": "node scripts/build-signed-windows-release.mjs",
    "package:win:local-test": "npm run verify:license-sync && npm run build && npm run verify:installer --workspace @ppt/desktop && node scripts/run-electron-builder.mjs --local-unsigned",
    "package:win:dir": "npm run verify:license-sync && npm run build && npm run verify:installer --workspace @ppt/desktop && node scripts/run-electron-builder.mjs --dir",
    "verify:installer": "node scripts/verify-installer.mjs",
    "verify:freeze": "node scripts/verify-release-freeze.mjs",
    "verify": "npm run verify:license-sync && npm run typecheck && npm test && npm run build && npm run verify:installer",
    "sync:license:rtf": "node scripts/generate-license-rtf.mjs",
    "verify:license-sync": "node scripts/verify-license-rtf-sync.mjs"
  },
  "build": {
    "appId": "tr.anadoluparsi.aileyasammerkezi",
    "productName": "ParsYuva Aile Yaşam Merkezi",
    "executableName": "ParsYuva",
    "asar": true,
    "afterPack": "scripts/apply-electron-fuses.mjs",
    "forceCodeSigning": true,
    "electronDownload": {
      "cache": "../../artifacts/validation/electron-cache"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ParsYuva-Bronze-20.08.2026.40.${ext}",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": true,
      "allowElevation": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "tr_TR"
      ],
      "include": "build/installer.nsh",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ParsYuva",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "copyright": "Copyright © 2026 ParsYuva",
    "artifactName": "ParsYuva-Bronze-20.08.2026.40.${ext}"
  },
  "description": "ParsYuva Aile Yaşam Merkezi yerel öncelikli aile yaşam, güvenlik ve dijital hafıza merkezi.",
  "author": {
    "name": "ParsYuva"
  }
}
